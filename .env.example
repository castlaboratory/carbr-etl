# Credenciais de escrita no bucket (Cloudflare R2, API S3). Copie para .env (modo 600).
# Os nomes estão com a grafia usada no projeto.
R2_S3API=https://<id-da-conta>.r2.cloudflarestorage.com
ACESS_KEY_ID=
SECRET_ACESS_KEY=
# Opcional: nome do bucket (padrão: car)
# R2_BUCKET=car
# Opcional: para onde vai o aviso por e-mail ao fim de cada rodada (precisa do msmtp; ver deploy/)
# NOTIFY_TO=
# NOTIFY_FROM=dev@castlab.org
